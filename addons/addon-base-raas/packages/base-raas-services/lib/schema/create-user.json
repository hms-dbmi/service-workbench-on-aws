{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "format": "email",
      "pattern": "^(?:[A-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-z0-9!#$%&'*+/=?^_`{|}~-]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[A-z0-9](?:[A-z0-9-]*[A-z0-9])?\\.)+[A-z0-9](?:[A-z0-9-]*[A-z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[A-z0-9-]*[A-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])"
    },
    "usernameInIdp": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "password": {
      "type": "string"
    },
    "authenticationProviderId": {
      "type": "string"
    },
    "identityProviderName": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "pattern": "^(?:[A-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-z0-9!#$%&'*+/=?^_`{|}~-]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[A-z0-9](?:[A-z0-9-]*[A-z0-9])?\\.)+[A-z0-9](?:[A-z0-9-]*[A-z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[A-z0-9-]*[A-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9 .-]+$"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9 .-]+$"
    },
    "userType": {
      "type": "string",
      "enum": ["root"]
    },
    "isSamlAuthenticatedUser": {
      "type": "boolean"
    },
    "isNativePoolUser": {
      "type": "boolean",
      "default": false
    },
    "isAdmin": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "pending"]
    },
    "rev": {
      "type": "number",
      "minimum": 0
    },
    "userRole": {
      "type": "string"
    },
    "projectId": {
      "type": "array"
    },
    "isExternalUser": {
      "type": "boolean"
    },
    "encryptedCreds": {
      "type": "string"
    },
    "applyReason": {
      "type": "string",
      "default": "N/A"
    },
    "aaAffiliation": {
      "type": "string",
      "maxLength": 500
    },
    "aaProjectId": {
      "type": "string",
      "maxLength": 500
    },
    "aaProjectName": {
      "type": "string",
      "maxLength": 500
    },
    "piName": {
      "type": "string",
      "maxLength": 500
    },
    "dataSources": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ],
      "uniqueItems": true
    }
  },
  "required": ["username"]
}
